{
  "name": "knowledgeos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:qdrant": "pnpm --filter @kos/retrieval build && pnpm --filter @kos/evaluation bench:qdrant",
    "eval:retrieval": "pnpm --filter @kos/evaluation eval:retrieval",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "accept:v1": "node scripts/acceptance-v1.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "clean:test-data": "pnpm --filter @kos/database exec node scripts/clean-test-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
